# ---- core ----
PORT=8000
MONGO_URL=mongodb://localhost:27017/watchtower
NODE_ENV=development

# ---- auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=1d

# ---- urls / cors ----
FRONTEND_URL=http://localhost:5173
# Comma-separated allow-list. Never use a wildcard in production.
CORS_ORIGIN=http://localhost:5173

# ---- mail (incident notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# ---- ai (optional; incident summaries degrade gracefully if unset) ----
MISTRAL_API_KEY=your-mistral-api-key

# ---- security ----
# Encrypts outbound monitor credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Without it, monitors cannot store auth headers at all — storing them errors
# rather than silently writing plaintext. See SECURITY.md T4.
CREDENTIALS_ENCRYPTION_KEY=

# Registration currently marks accounts verified immediately, skipping the OTP
# email flow. Set to false to require real email verification.
# See SECURITY.md §5 item 1 — this is an accepted, documented risk.
AUTO_VERIFY_USERS=true

# ---- scheduler (all optional; defaults shown) ----
# See docs/SCHEDULER.md for the full behavioural contract.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=5000
SCHEDULER_CONCURRENCY=10
SCHEDULER_LOCK_TTL_MS=30000
SCHEDULER_SHUTDOWN_GRACE_MS=10000

# ---- per-check retry ladder ----
CHECK_MAX_RETRIES=2
CHECK_RETRY_BASE_MS=250
CHECK_RETRY_CAP_MS=4000

# ---- circuit breaker ----
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=60000
BREAKER_MAX_COOLDOWN_MS=900000

# ---- retention ----
# TTL on the logs collection, in days. Must be >= the widest uptime window (30d).
LOG_RETENTION_DAYS=30

# ---- observability (see docs/RUNBOOK.md) ----
# pino level: fatal|error|warn|info|http|debug|trace
LOG_LEVEL=info
# Write log FILES as well as stdout. Off by default: in a container these are
# invisible to `docker logs` and discarded when the container is replaced.
LOG_TO_FILE=false
# Require `Authorization: Bearer <token>` on /metrics. Left unset the endpoint is
# open — a scrape endpoint that 401s at an unconfigured scraper looks exactly
# like a service that is down. Set this in production.
METRICS_TOKEN=
